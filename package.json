{
  "name": "dsh-rich-context",
  "version": "0.2.0",
  "description": "Agent manager for DeepSeek Harness: edit AGENTS.md (global + per-workspace) and subagent personas — one Codex-style TOML per role carrying a provider/model/effort route, compiled to a DSH agent preset, launchable as a real session from the panel or the model-facing agents tool.",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "dsh",
    "agents-md",
    "subagents",
    "agent-personas",
    "agent-presets",
    "context-management",
    "instruction-files",
    "web-gui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/savageops/dsh-rich-context.git"
  },
  "homepage": "https://github.com/savageops/dsh-rich-context#readme",
  "bugs": {
    "url": "https://github.com/savageops/dsh-rich-context/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./src/client.bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
